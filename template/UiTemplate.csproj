<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UiTemplate: a minimal, generic WinUI 3 desktop-tool skeleton.

    It demonstrates the shell described in docs/UI-DESIGN.md: a custom title bar,
    a NavigationView sidebar, multi-page settings edited through a draft + Apply
    model, and an adjustable appearance (theme / opacity / Mica / Acrylic /
    background image).  Nothing here is specific to any one tool.

    BUILD
      cd template
      dotnet build -c Release

    RUN (read this, the exe in the project root is not the one to launch)
      WindowsAppSDKSelfContained = true means the Windows App SDK runtime DLLs are
      copied next to the exe inside the output folder instead of being taken from
      the system.  An unpackaged, self-contained app therefore only starts from

        bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\

      Launching a copy that sits anywhere else (for example one manually copied to
      the project root) exits immediately with 0x8000801A, because the runtime
      cannot find its own DLLs.

    REBUILD
      The output exe is locked while the app is running, so kill it before
      rebuilding or the build fails with MSB3027 / MSB3021:

        taskkill /F /IM UiTemplate.exe

    AppxMSBuildToolsPath points the Appx/PRI build tasks at an installed Visual
    Studio 2022.  The dotnet CLI does not ship those tasks, so PRI generation
    would otherwise fail.  Adjust the path (and the edition) to match your own
    Visual Studio installation if it is not Community on C:.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>UiTemplate</RootNamespace>
    <AssemblyName>UiTemplate</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <UseWPF>false</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <AppxMSBuildToolsPath>C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- GDI+ is only used for the background image blur (AppearanceManager). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
